# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file. It is already covered by .gitignore.

# --- Sepolia testnet deployment (optional — only needed once you go beyond local Hardhat) ---

# A free public RPC endpoint. Leave unset to use the built-in free publicnode.com
# endpoint in hardhat.config.js. Alternatively, sign up for a free-tier project at
# https://www.alchemy.com or https://www.infura.io and paste its HTTPS URL here.
SEPOLIA_RPC_URL=

# Private key of the wallet you'll deploy from, WITHOUT the "0x" prefix stripped
# (Hardhat accepts it with or without "0x"). Use a throwaway MetaMask account funded
# only with free Sepolia faucet ETH — never your real wallet's key.
PRIVATE_KEY=

# Optional: free Etherscan API key (https://etherscan.io/apis) used only for
# `npx hardhat verify` to publish contract source on the Sepolia block explorer.
ETHERSCAN_API_KEY=
